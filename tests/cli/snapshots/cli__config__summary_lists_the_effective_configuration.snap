---
source: tests/cli/config.rs
expression: "out.replace(&home, \"<HOME>\")"
---
config file: <HOME>/.config/work/config.toml (exists)
work_dir:    <HOME>/code
cache_path:  <HOME>/.local/state/work
filters:
  include_orgs: (none)
  exclude_orgs: archived-org
domains:
  ghe.example.com
    favorite_orgs: (none)
    extra_orgs:    guests
    api_url:       https://ghe.example.com/api/v3 (default)
  github.com (default)
    favorite_orgs: my-team, my-company
    extra_orgs:    (none)
    api_url:       https://api.github.com (default)
