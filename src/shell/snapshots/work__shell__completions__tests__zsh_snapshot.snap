(( $+functions[_work__subcmd__on_commands] )) ||
_work__subcmd__on_commands() {
    local commands; commands=()
    _describe -t commands 'work on commands' commands "$@"
}
(( $+functions[_work__subcmd__open_commands] )) ||
_work__subcmd__open_commands() {
    local commands; commands=()
    _describe -t commands 'work open commands' commands "$@"
}
(( $+functions[_work__subcmd__pull_commands] )) ||
_work__subcmd__pull_commands() {
    local commands; commands=()
    _describe -t commands 'work pull commands' commands "$@"
}
(( $+functions[_work__subcmd__setup_commands] )) ||
_work__subcmd__setup_commands() {
    local commands; commands=()
    _describe -t commands 'work setup commands' commands "$@"
}
(( $+functions[_work__subcmd__sync_commands] )) ||
_work__subcmd__sync_commands() {
    local commands; commands=()
    _describe -t commands 'work sync commands' commands "$@"
}
(( $+functions[_work__subcmd__update_commands] )) ||
_work__subcmd__update_commands() {
    local commands; commands=()
    _describe -t commands 'work update commands' commands "$@"
}
(( $+functions[_work__subcmd__version_commands] )) ||
_work__subcmd__version_commands() {
    local commands; commands=()
    _describe -t commands 'work version commands' commands "$@"
}

# Repo names from the cache for commands that resolve a repo.
_work() {
    case "$words[2]" in
        cd|on|edit|clone|browse|open|pull|list)
            if [[ "$words[CURRENT]" != -* ]]; then
                local w positional=0
                for w in "${(@)words[3,CURRENT-1]}"; do
                    [[ "$w" != -* ]] && positional=1
                done
                if (( positional == 0 )); then
                    local -a repos
                    repos=(${(f)"$(work list --complete 2>/dev/null)"})
                    compadd -a repos
                    return
                fi
            fi
            ;;
    esac
    _work_clap "$@"
}

if [ "$funcstack[1]" = "_work" ]; then
    _work "$@"
else
    compdef _work work
fi
