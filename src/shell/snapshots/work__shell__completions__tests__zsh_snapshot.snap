---
source: src/shell/completions.rs
expression: "script(Shell::Zsh)"
---
#compdef work

autoload -U is-at-least

_work_clap() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
":: :_work_commands" \
"*::: :->work" \
&& ret=0
    case $state in
    (work)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:work-command-$line[1]:"
        case $line[1] in
            (cd)
_arguments "${_arguments_options[@]}" : \
'--pick[Always show the picker when several repositories match]' \
'-h[Print help]' \
'--help[Print help]' \
'::query -- Repository query; omit to go to the work directory:_default' \
&& ret=0
;;
(on)
_arguments "${_arguments_options[@]}" : \
'--pick[Always show the picker when several repositories match]' \
'-h[Print help]' \
'--help[Print help]' \
':query -- Repository query\: name, org/name, or domain/org/name:_default' \
&& ret=0
;;
(edit)
_arguments "${_arguments_options[@]}" : \
'--pick[Always show the picker when several repositories match]' \
'-h[Print help]' \
'--help[Print help]' \
':query -- Repository query\: name, org/name, or domain/org/name:_default' \
&& ret=0
;;
(clone)
_arguments "${_arguments_options[@]}" : \
'--pick[Always show the picker when several repositories match]' \
'-h[Print help]' \
'--help[Print help]' \
':query -- Repository query\: name, org/name, or domain/org/name:_default' \
&& ret=0
;;
(browse)
_arguments "${_arguments_options[@]}" : \
'--pick[Always show the picker when several repositories match]' \
'-h[Print help]' \
'--help[Print help]' \
':query -- Repository query\: name, org/name, or domain/org/name:_default' \
&& ret=0
;;
(open)
_arguments "${_arguments_options[@]}" : \
'--pick[Always show the picker when several repositories match]' \
'-h[Print help]' \
'--help[Print help]' \
':query -- Repository query\: name, org/name, or domain/org/name:_default' \
&& ret=0
;;
(pull)
_arguments "${_arguments_options[@]}" : \
'--pick[Always show the picker when several repositories match]' \
'-h[Print help]' \
'--help[Print help]' \
':query -- Repository query\: name, org/name, or domain/org/name:_default' \
&& ret=0
;;
(sync)
_arguments "${_arguments_options[@]}" : \
'-j+[Repositories to sync at once]:JOBS:_default' \
'--jobs=[Repositories to sync at once]:JOBS:_default' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(list)
_arguments "${_arguments_options[@]}" : \
'--filter[Plain substring match on the full slug, without frecency]' \
'-h[Print help]' \
'--help[Print help]' \
'::query -- Rank repositories against this query:_default' \
&& ret=0
;;
(update)
_arguments "${_arguments_options[@]}" : \
'--all-orgs[Fetch every org, ignoring favourites]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(favorite)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'::domain -- Domain to pick favourites for (asks when several are configured):_default' \
&& ret=0
;;
(setup)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'::domain -- Domain to set up (default\: github.com):_default' \
&& ret=0
;;
(config)
_arguments "${_arguments_options[@]}" : \
'--edit[Open the config file in your editor]' \
'-h[Print help]' \
'--help[Print help]' \
":: :_work__subcmd__config_commands" \
"*::: :->config" \
&& ret=0

    case $state in
    (config)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:work-config-command-$line[1]:"
        case $line[1] in
            (path)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(default)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'::domain -- The new default domain:_default' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_work__subcmd__config__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:work-config-help-command-$line[1]:"
        case $line[1] in
            (path)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(default)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
;;
(auth)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
":: :_work__subcmd__auth_commands" \
"*::: :->auth" \
&& ret=0

    case $state in
    (auth)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:work-auth-command-$line[1]:"
        case $line[1] in
            (login)
_arguments "${_arguments_options[@]}" : \
'--domain=[GitHub host]:DOMAIN:_default' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(logout)
_arguments "${_arguments_options[@]}" : \
'--domain=[GitHub host]:DOMAIN:_default' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_work__subcmd__auth__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:work-auth-help-command-$line[1]:"
        case $line[1] in
            (login)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(logout)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
;;
(completions)
_arguments "${_arguments_options[@]}" : \
'--install[Write the script to the shell'\''s completion directory]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'::shell -- Shell (default\: detected from $SHELL):((bash\:"GNU bash"
zsh\:"zsh"
fish\:"fish"))' \
&& ret=0
;;
(activate)
_arguments "${_arguments_options[@]}" : \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'::shell -- Shell (default\: detected from $SHELL):((bash\:"GNU bash"
zsh\:"zsh"
fish\:"fish"))' \
&& ret=0
;;
(version)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(about)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_work__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:work-help-command-$line[1]:"
        case $line[1] in
            (cd)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(on)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(edit)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(clone)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(browse)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(open)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(pull)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(sync)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(list)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(update)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(favorite)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(setup)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(config)
_arguments "${_arguments_options[@]}" : \
":: :_work__subcmd__help__subcmd__config_commands" \
"*::: :->config" \
&& ret=0

    case $state in
    (config)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:work-help-config-command-$line[1]:"
        case $line[1] in
            (path)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(default)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
(auth)
_arguments "${_arguments_options[@]}" : \
":: :_work__subcmd__help__subcmd__auth_commands" \
"*::: :->auth" \
&& ret=0

    case $state in
    (auth)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:work-help-auth-command-$line[1]:"
        case $line[1] in
            (login)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(logout)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
