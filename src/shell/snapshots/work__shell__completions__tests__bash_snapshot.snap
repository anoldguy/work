        work__subcmd__version)
            opts="-h --help"
            if [[ ${cur} == -* || ${COMP_CWORD} -eq 2 ]] ; then
                COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
                return 0
            fi
            case "${prev}" in
                *)
                    COMPREPLY=()
                    ;;
            esac
            COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
            return 0
            ;;
    esac
}

# Repo names from the cache for commands that resolve a repo.
_work_with_repos() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    case "${COMP_WORDS[1]}" in
        cd|on|edit|clone|browse|open|pull|list)
            if [[ "$cur" != -* ]]; then
                local i positional=0
                for ((i = 2; i < COMP_CWORD; i++)); do
                    [[ "${COMP_WORDS[i]}" != -* ]] && positional=1
                done
                if [[ $positional -eq 0 ]]; then
                    local IFS=$'\n'
                    COMPREPLY=( $(compgen -W "$(work list --complete 2>/dev/null)" -- "$cur") )
                    return 0
                fi
            fi
            ;;
    esac
    _work "$@"
}

if [[ "${BASH_VERSINFO[0]}" -eq 4 && "${BASH_VERSINFO[1]}" -ge 4 || "${BASH_VERSINFO[0]}" -gt 4 ]]; then
    complete -F _work_with_repos -o nosort -o bashdefault -o default work
else
    complete -F _work_with_repos -o bashdefault -o default work
fi
