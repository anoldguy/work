---
source: src/shell/completions.rs
expression: "script(Shell::Bash)"
---
_work() {
    local i cur prev opts cmd
    COMPREPLY=()
    if [[ "${BASH_VERSINFO[0]}" -ge 4 ]]; then
        cur="$2"
    else
        cur="${COMP_WORDS[COMP_CWORD]}"
    fi
    prev="$3"
    cmd=""
    opts=""

    for i in "${COMP_WORDS[@]:0:COMP_CWORD}"
    do
        case "${cmd},${i}" in
            ",$1")
                cmd="work"
                ;;
            work,about)
                cmd="work__subcmd__about"
                ;;
            work,activate)
                cmd="work__subcmd__activate"
                ;;
            work,auth)
                cmd="work__subcmd__auth"
                ;;
            work,browse)
                cmd="work__subcmd__browse"
                ;;
